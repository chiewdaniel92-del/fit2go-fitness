# Server-side secrets for scripts/ingest_kb.py.
#
# Kept separate from .env on purpose: .env is bundled into the client by Vite,
# and a service-role key does not belong anywhere near that. Nothing in this
# file should ever be given a VITE_ prefix.
#
#   cp .env.ingest.example .env.ingest   # then fill in the values
#   python scripts/ingest_kb.py --env-file .env.ingest ...

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
