# Frontend config, read by Vite and bundled into the client.
# Everything here is public by design — never put a secret in this file.
# Find these under Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-side secrets live in .env.ingest instead — see .env.ingest.example.
